#!/usr/bin/env bash
# Install the pinned Hugo (extended) release into a directory.
# Shared by CI (.github/workflows/site.yml) and orb setup (.agents/setup)
# so both always build with the same version. Bump HUGO_VERSION here only.
#
# Usage: scripts/install-hugo <install-dir>
set -euo pipefail

HUGO_VERSION="0.167.0"
dest="${1:?usage: install-hugo <install-dir>}"

if [[ -x "$dest/hugo" ]] && "$dest/hugo" version | grep -q "v${HUGO_VERSION}-.*+extended"; then
  echo "hugo v${HUGO_VERSION} already installed in $dest"
  exit 0
fi

tarball="hugo_extended_${HUGO_VERSION}_linux-amd64.tar.gz"
base="https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

curl -fsSL --retry 3 -o "$tmp/$tarball" "$base/$tarball"
curl -fsSL --retry 3 -o "$tmp/checksums.txt" "$base/hugo_${HUGO_VERSION}_checksums.txt"
(cd "$tmp" && grep " ${tarball}\$" checksums.txt | sha256sum -c --quiet -)

mkdir -p "$dest"
tar -xzf "$tmp/$tarball" -C "$tmp" hugo
install -m 0755 "$tmp/hugo" "$dest/hugo"
"$dest/hugo" version
